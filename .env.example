# Copy this file to .env and adjust values before `docker compose up`.
# Every value is optional: docker-compose.yml carries safe demo defaults.

# Shared by order-service and instrument-service. Use at least 32 bytes.
JWT_SECRET=change-me-in-production-ncdex-commodity-order-management-hmac-secret-2026

# Demo users seeded by order-service at startup (only if missing).
SEED_DATA=true
DEMO_ADMIN_PASSWORD=Admin@123
DEMO_OPERATOR_PASSWORD=Operator@123

# PostgreSQL credentials used by the container and the order-service.
POSTGRES_DB=orderdb
POSTGRES_USER=orderuser
POSTGRES_PASSWORD=orderpass

# Redis cache TTL for instrument records.
INSTRUMENT_CACHE_TTL_SECONDS=300

# Document storage: local (default) or s3.
STORAGE_TYPE=local
# For a real S3 or S3-compatible (MinIO/LocalStack) backend:
# STORAGE_TYPE=s3
# AWS_S3_BUCKET=ncdex-order-documents
# AWS_REGION=ap-south-1
# AWS_S3_ENDPOINT=http://minio:9000   # omit for real AWS
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
